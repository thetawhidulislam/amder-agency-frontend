# Public (used by the browser: contact form + admin panel)
# Production: NEXT_PUBLIC_API_URL=https://api.amaderagency.com
NEXT_PUBLIC_API_URL=http://localhost:5000
# Production: NEXT_PUBLIC_SITE_URL=https://amaderagency.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only (used by Next.js server components). Falls back to NEXT_PUBLIC_API_URL.
# Production: API_URL=https://api.amaderagency.com
API_URL=http://localhost:5000

# Must match REVALIDATE_SECRET in the backend .env
REVALIDATE_SECRET=
